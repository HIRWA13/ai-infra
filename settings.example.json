{
  "env": {
    "TAVILY_API_KEY": ""
  },
  "permissions": {
    "allow": [
      "WebSearch"
    ]
  },
  "model": "opus",
  "enabledMcpjsonServers": [
    "tavily"
  ],
  "statusLine": {
    "type": "command",
